<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PickleBlackbox" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bb_primary</item>
        <item name="colorOnPrimary">@color/bb_on_primary</item>
        <item name="colorPrimaryContainer">@color/bb_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/bb_text</item>
        <item name="colorSecondary">@color/bb_accent</item>
        <item name="colorSurface">@color/bb_surface</item>
        <item name="colorOnSurface">@color/bb_text</item>
        <item name="colorOnSurfaceVariant">@color/bb_text_dim</item>
        <item name="android:colorBackground">@color/bb_background</item>
        <item name="android:windowBackground">@color/bb_background</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialAlertDialogTheme">@style/Theme.PickleBlackbox.Dialog</item>
    </style>

    <style name="Theme.PickleBlackbox.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/bb_surface_high</item>
        <item name="colorOnSurface">@color/bb_text</item>
    </style>

    <style name="TextAppearance.PickleBlackbox.HudLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/bb_text_dim</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.PickleBlackbox.HudValue" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/bb_text</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="TextAppearance.PickleBlackbox.Timer" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/bb_text</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
