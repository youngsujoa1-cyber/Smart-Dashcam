<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/TextAppearance.PickleBlackbox.HudLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_segment_title" />

        <RadioGroup
            android:id="@+id/rgSegment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbSegment1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_segment_1min" />

            <RadioButton
                android:id="@+id/rbSegment3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_segment_3min" />

            <RadioButton
                android:id="@+id/rbSegment5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_segment_5min" />
        </RadioGroup>

        <TextView
            style="@style/TextAppearance.PickleBlackbox.HudLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_storage_title" />

        <RadioGroup
            android:id="@+id/rgStorage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbStorage1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_storage_1gb" />

            <RadioButton
                android:id="@+id/rbStorage2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_storage_2gb" />

            <RadioButton
                android:id="@+id/rbStorage5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_storage_5gb" />
        </RadioGroup>

        <TextView
            style="@style/TextAppearance.PickleBlackbox.HudLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_sensitivity_title" />

        <SeekBar
            android:id="@+id/sbSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="5"
            android:min="1" />

        <TextView
            android:id="@+id/tvSensitivityValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bb_text_dim"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swAutoLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_auto_lock"
            android:textColor="@color/bb_text" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_record_audio"
            android:textColor="@color/bb_text" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_show_speed"
            android:textColor="@color/bb_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/settings_note"
            android:textColor="@color/bb_text_dim"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
